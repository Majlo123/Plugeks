# Slanje upita sa forme „Zatraži ponudu" (src/app/api/upit/route.ts).
# Za lokalni rad prekopiraj u .env.local; na Vercel-u unesi u
# Settings -> Environment Variables.

# Obavezno. API kljuc sa https://resend.com (Dashboard -> API Keys).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Opciono. Gde stizu upiti. Bez ovoga ide na site.email iz src/lib/site.ts.
# UPIT_TO=plugeks@gmail.com

# Opciono. Posiljalac. Dok plugeks.com nije verifikovan na Resend-u, ostavi
# nepodeseno — koristi se onboarding@resend.dev, koji sme da salje samo na
# adresu vlasnika Resend naloga.
# UPIT_FROM=PlugekS sajt <upit@plugeks.com>
